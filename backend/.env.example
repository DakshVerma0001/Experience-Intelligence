# Experience Intelligence backend configuration
# Copy this file to .env and adjust values. Never commit the real .env.

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-64-char-secret
APP_DATABASE_URL=sqlite:///./storage/experience_intelligence.db
APP_STORAGE_DIR=./storage
APP_MAX_UPLOAD_MB=25
APP_CORS_ORIGINS=http://localhost:5173

# --- Auth (local identity store; see docs/security.md for SSO integration point) ---
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Ollama (local LLM inference, no external API) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=300

# --- Embeddings (local, replaceable) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence-transformers
VECTOR_STORE_DIR=./storage/chroma

# --- Import policy defaults ---
AUTO_IMPORT_ENABLED=false
CONFIDENCE_THRESHOLD=0.85
DUPLICATE_LIKELY_THRESHOLD=0.90
DUPLICATE_POSSIBLE_THRESHOLD=0.75

# --- Production Portal Import Gateway (service-to-service only, never user passwords) ---
PORTAL_IMPORT_URL=http://localhost:9000/api/internal/experience-import
PORTAL_HEALTH_URL=http://localhost:9000/api/internal/health
PORTAL_IMPORT_CLIENT_ID=experience-intelligence
PORTAL_IMPORT_SECRET=dev-shared-secret-change-me
